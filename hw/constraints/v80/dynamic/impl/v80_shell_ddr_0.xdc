###
### V80 onboard DDR4 (4 GB, 1 channel, 1 rank, x16 components, x72 with ECC).
### Active only when EN_AMC=1 (or any future build that enables N_DDR_CHAN > 0
### on V80). The DDR4 controller is hard-NoC-attached (`axi_noc_mc_ddr4_0` in
### `cr_ddr4_v80.tcl`); these constraints just pin the controller's PHY ports
### to the V80 board's DDR4 traces.
###
### Vendored from AVED `amd_v80_gen5x8_25.1/src/constraints/impl.pins.xdc`.
### 116 CH0_DDR4_0_0_* lines + 1 sys_clk0_0_clk_p (200 MHz LVDS, _n auto-paired).
###

# DDR4 system clock (200 MHz differential, for memory controller calibration)
set_property -dict { PACKAGE_PIN BY9     IOSTANDARD LVDS15 } [get_ports "sys_clk0_0_clk_p"]
# _n half is auto-paired by Vivado (LVDS adjacent pin)

# ----------------------------------------------------------------------------
# CH0_DDR4_0_0 — onboard 4 GB DDR4 PHY pins, banks 700/701/702/703
# ----------------------------------------------------------------------------

# Address / Control (Bank 700 — SSTL12)
set_property -dict { PACKAGE_PIN BR15    IOSTANDARD SSTL12        } [get_ports "CH0_DDR4_0_0_act_n[0]"]
set_property -dict { PACKAGE_PIN BP15    IOSTANDARD SSTL12        } [get_ports "CH0_DDR4_0_0_adr[0]"]
set_property -dict { PACKAGE_PIN BU8     IOSTANDARD SSTL12        } [get_ports "CH0_DDR4_0_0_adr[1]"]
