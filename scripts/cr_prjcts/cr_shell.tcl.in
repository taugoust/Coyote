# @brief Creates a Vivado project for the shell layer, without user logic.
# Additionally, creates and configures all the necessary IPs for memory, networking etc.

if {[catch {
    
########################################################################################################

# Config & environment
unset ::env(PYTHONPATH)
unset ::env(PYTHONHOME)

source "${CMAKE_BINARY_DIR}/base.tcl"

set external_dynamic_service_sources [list ${EXTERNAL_DYNAMIC_SERVICE_SOURCES_TCL}]
set external_dynamic_service_include_dirs [list ${EXTERNAL_DYNAMIC_SERVICE_INCLUDE_DIRS_TCL}]
set external_dynamic_service_init_tcl [lindex [list ${EXTERNAL_DYNAMIC_SERVICE_INIT_TCL_TCL}] 0]
set coprocessor_provider_sources [list ${COPROCESSOR_PROVIDER_SOURCES_TCL}]
set coprocessor_provider_include_dirs [list ${COPROCESSOR_PROVIDER_INCLUDE_DIRS_TCL}]
set coprocessor_provider_init_tcl [list ${COPROCESSOR_PROVIDER_INIT_TCL_TCL}]

########################################################################################################
# CREATE PROJECT
########################################################################################################
puts "[color $clr_flow "** Creating shell project ..."]"
puts "[color $clr_flow "**"]"

# Create project
set proj_dir "$build_dir/$project\_shell"
create_project $project $proj_dir -part $part -force
set proj [current_project]
# IP repo paths: start with Coyote's own iprepo. When EN_AMC=1 on V80,
# also include the AVED iprepo (cmd_queue, hw_discovery, uuid_rom IPs).
set ip_repos [list $lib_dir]
if {$cfg(en_amc) eq 1} {
    lappend ip_repos $cfg(aved_iprepo)
    puts "[color $clr_flow "** EN_AMC=1, adding AVED iprepo: $cfg(aved_iprepo)"]"
}
set_property IP_REPO_PATHS $ip_repos [current_fileset]
update_ip_catalog

set_msg_config -id {Vivado 12-2924} -suppress
set_msg_config -id {IP_Flow 19-4832} -suppress
set_msg_config -id {BD 41-927} -suppress

file mkdir "$dcp_dir/shell"
file mkdir "$rprt_dir/shell"
file mkdir "$log_dir/shell"

########################################################################################################
# SET PROJECT PROPERTIES
########################################################################################################
#set_property "board_part" $board_part                      $proj
set_property "default_lib" "xil_defaultlib"                 $proj
set_property "ip_cache_permissions" "read write"            $proj
set_property "ip_output_repo" "$proj_dir/$project.cache/ip" $proj
set_property "sim.ip.auto_export_scripts" "1"               $proj
set_property "target_language" "Verilog"                    $proj
set_property "simulator_language" "Mixed"                   $proj
set_property "xpm_libraries" "XPM_CDC XPM_MEMORY XPM_NOC"   $proj

########################################################################################################
# CREATE & ADD FILES
########################################################################################################
file mkdir "$proj_dir/hdl"
file mkdir "$proj_dir/xdc"

# Call write HDL scripts
proc call_write_hdl {r_path op c_cnfg c_reg} {
    set output [exec /usr/bin/python3 "$r_path/write_hdl.py" $op $c_cnfg $c_reg]
    puts $output
}
call_write_hdl $build_dir 1 0 0

# Add source files
add_files "$hw_dir/hdl/pkg"
add_files "$hw_dir/hdl/shell"
add_files "$hw_dir/hdl/mmu"
add_files "$hw_dir/hdl/common"
if {$cfg(n_coprocessor_ports) > 0} {
    add_files "$hw_dir/hdl/coprocessor"
}
if {$cfg(en_card) eq 1} {
    add_files "$hw_dir/hdl/stripe"
    add_files "$hw_dir/hdl/cdma/cdma_u"
}
if {$cfg(en_net) eq 1} {
    # MAC layer: CMAC (UltraScale+) or DCMAC (Versal). Pick based on arch —
    # V80 has no UltraScale+ CMAC IP, only DCMAC; U280/U250 use the older CMAC.
    # DCMAC HDL is the reusable package from fpgasystems/Versal-DCMAC.
    if {$cfg(fpga_arch) eq "versal"} {
        # hdl/network/dcmac is the vendored fpgasystems/Versal-DCMAC package;
        # hdl/network/dcmac_cyt holds the Coyote-authored glue, kept in a
        # separate directory so the vendored one stays a straight `cp` target
        # on future upstream pulls.
        add_files "$hw_dir/hdl/network/dcmac"
        add_files "$hw_dir/hdl/network/dcmac_cyt"
    } else {
        add_files "$hw_dir/hdl/network/cmac"
    }
    add_files "$hw_dir/hdl/network/stack"
    # network_stack.sv and network_packet_sniffer.sv instantiate HLS cores from
    # the fpga-network-stack submodule plus axis_interconnect and vio, none of
    # which exist for a Versal part. Nothing instantiates either module on a raw
    # Ethernet build, but they are still parsed, so take them out of
    # compilation rather than leaving unresolvable references in the fileset.
    # network_module.sv needs no such treatment: its CMAC-only IP references sit
    # inside the `else` arm of its FPGA_ARCH_VERSAL branch and the preprocessor
    # removes them.
    if {$cfg(fpga_arch) eq "versal"} {
        set_property is_enabled false [get_files "$hw_dir/hdl/network/stack/network_stack.sv"]
        set_property is_enabled false [get_files "$hw_dir/hdl/network/stack/network_packet_sniffer.sv"]
    }
    if {$cfg(en_rdma) eq 1} {
        add_files "$hw_dir/hdl/network/rdma"
    }
    if {$cfg(en_tcp) eq 1} {
        add_files "$hw_dir/hdl/network/tcp"
    }
}
if {$cfg(en_qlink_gty) eq 1} {
    add_files "$hw_dir/hdl/qlink"
}
if {$cfg(en_aurora_1) eq 1} {
    add_files "$hw_dir/hdl/aurora"
}
add_files "$proj_dir/hdl"

if {$cfg(en_external_dynamic_service) eq 1} {
    add_files -norecurse $external_dynamic_service_sources
    if {[llength $external_dynamic_service_include_dirs] > 0} {
        set_property include_dirs \
            [concat [get_property include_dirs [current_fileset]] $external_dynamic_service_include_dirs] \
            [current_fileset]
    }
}
if {$cfg(coprocessor_provider_count) > 0} {
    if {[llength $coprocessor_provider_sources] > 0} {
        add_files -norecurse $coprocessor_provider_sources
    }
    if {[llength $coprocessor_provider_include_dirs] > 0} {
        set_property include_dirs \
            [concat [get_property include_dirs [current_fileset]] $coprocessor_provider_include_dirs] \
            [current_fileset]
    }
}

# Top level
set_property "top" "shell_top" [current_fileset]

# Constraints
add_files -norecurse -fileset [get_filesets constrs_1] "$proj_dir/xdc"
add_files -norecurse -fileset [get_filesets constrs_1] "$hw_dir/constraints/$cfg(fdev)/shell/synth"
set_property used_in_implementation false [get_files -of_objects [get_filesets constrs_1]]
# Network-3 P2P: the create_noc_connection XDC must run BEFORE synthesis so the NoC
# is built into the shell netlist (mirrors the AMD RTL modular-NoC tutorial's
# USED_IN {synthesis_pre} on noc_constraints.xdc). validate_noc runs later on the
# linked design (CIPS present) in pnr_shell.
if {$cfg(fdev) eq "v80" && $cfg(en_p2p) eq 1 && $cfg(n_reg) > 1} {
    set p2p_conn_xdc [get_files -quiet "*p2p_noc_conn.xdc"]
    if {$p2p_conn_xdc ne ""} {
        set_property USED_IN {synthesis_pre} $p2p_conn_xdc
    }
}
# Host DMA over NoC: same synthesis_pre treatment for the host-DMA NoC connections.
if {$cfg(fdev) eq "v80" && $cfg(en_host_noc) eq 1 && $cfg(n_reg) > 1} {
    set host_conn_xdc [get_files -quiet "*host_noc_conn.xdc"]
    if {$host_conn_xdc ne ""} {
        set_property USED_IN {synthesis_pre} $host_conn_xdc
    }
}
# Control/descriptor over NoC: same synthesis_pre treatment for the SQ/CQ + notify NoC connections.
if {$cfg(fdev) eq "v80" && $cfg(en_host_noc) eq 1 && $cfg(n_reg) > 1} {
    set host_ctrl_conn_xdc [get_files -quiet "*host_ctrl_noc_conn.xdc"]
    if {$host_ctrl_conn_xdc ne ""} {
        set_property USED_IN {synthesis_pre} $host_ctrl_conn_xdc
    }
}
# set_property -name {STEPS.SYNTH_DESIGN.ARGS.MORE OPTIONS} -value {-mode out_of_context} -objects [get_runs synth_1]

# Create a project-local constraint file to take debugging constraints that we don't want to propagate to the repository.
file mkdir "$proj_dir/$project.srcs/constrs_1"
close [ open "$proj_dir/$project.srcs/constrs_1/local.xdc" w ]

set_property target_constrs_file "$proj_dir/$project.srcs/constrs_1/local.xdc" [current_fileset -constrset]

########################################################################################################
# SHELL INFRASTRUCTURE
########################################################################################################
source "$scripts_dir/ip_inst/shell_infrastructure.tcl" -notrace
source "$scripts_dir/ip_inst/common_infrastructure.tcl" -notrace
if {$cfg(en_card) eq 1} {
    source "$scripts_dir/ip_inst/memory_infrastructure.tcl" -notrace
}
if {$cfg(en_net) eq 1} {
    source "$scripts_dir/ip_inst/network_infrastructure.tcl" -notrace
}
if {$cfg(en_external_dynamic_service) eq 1 && $external_dynamic_service_init_tcl ne ""} {
    source $external_dynamic_service_init_tcl
}
foreach provider_init $coprocessor_provider_init_tcl {
    source $provider_init
}
if {$cfg(en_aurora_1) eq 1} {
    source "$scripts_dir/ip_inst/aurora_infrastructure.tcl" -notrace
}
if {$cfg(en_qlink_gty) eq 1} {
    source "$scripts_dir/ip_inst/qlink_infrastructure.tcl" -notrace
}

########################################################################################################
# SHELL BLOCK DESIGNS
########################################################################################################
source "$hw_dir/bd/$cfg(fpga_arch)/cr_ctrl.tcl" -notrace
cr_bd_design_ctrl ""
set_property SYNTH_CHECKPOINT_MODE "Hierarchical" [get_files design_ctrl.bd ]

# On UltraScale+, we use the AXI Crossbar IP to separate the various control signals for each vFPGA
# On Versal devices, the AXI Crossbar is no longer supported and a SmartConnect IP should be used instead.
# However, the SmartConnect IP must be instantiated in a block diagram, as done below.
if {$cfg(fpga_arch) eq "versal"} {
    source "$hw_dir/bd/$cfg(fpga_arch)/cr_xbar.tcl" -notrace
    for {set i 0}  {$i < $cfg(n_reg)} {incr i} {    
        cr_bd_dyn_xbar $i
        set cmd "set_property SYNTH_CHECKPOINT_MODE \"Hierarchical\" \[ get_files dyn_crossbar_$i.bd \]"
        eval $cmd
    }
}

# Versal MAC layer: the 200G DCMAC ships as a block design, not a plain IP.
# It lives in the shell (not the static layer) because a V80 network build
# forces EN_SHELL_PBLOCK=0, so inst_shell is never a reconfigurable partition
# and the GT quads are static silicon either way.
#
# nclk_f is passed explicitly rather than left empty: bd_dcmac's empty-string
# fallback reaches for a global cfg(nclk_f) via upvar, which works here but
# only by luck of scope.
#
# EN_NET_0 / EN_NET_1 select which DCMAC site, and therefore which pair of QSFP
# cages is reachable:
#   EN_NET_0 -> index 0 = DCMAC_X1Y1 -> GTM_QUAD_X1Y7, bank 209 = qsfp0
#   EN_NET_1 -> index 1 = DCMAC_X0Y2 -> GTM_QUAD_X0Y9, bank 111 = qsfp3
# dcmac_axis_wrapper.sv picks the matching block design module by `ifdef EN_NET_1.
if {$cfg(fpga_arch) eq "versal" && $cfg(en_net) eq 1} {
    set dcmac_index [expr {$cfg(en_net_1) eq 1 ? 1 : 0}]
    # cr_dcmac.tcl sources board_config.tcl itself, resolved relative to its own
    # location via `info script` — hence that file keeps its upstream name and
    # must sit next to it. Don't source it here as well.
    source "$hw_dir/bd/$cfg(fpga_arch)/cr_dcmac.tcl" -notrace

    # bd_dcmac picks its boundary style by probing current_bd_design: no design
    # open means standalone (it creates its own BD with external ports, which is
    # what we instantiate from dcmac_axis_wrapper.sv); a design open means inline
    # (pins on a caller-supplied hierarchical cell).
    #
    # The BD work above leaves a design current — cr_bd_design_ctrl and
    # cr_bd_dyn_xbar both close their own designs, but the
    # set_property SYNTH_CHECKPOINT_MODE calls on those .bd files make Vivado
    # open them again. Without this, bd_dcmac silently takes the inline path and
    # dies on its first boundary call with
    #   ERROR: [BD 5-253] Please change the current instance to a hierarchical cell
    # Assert the precondition rather than assuming it.
    for {set i 0} {$i < 8 && [current_bd_design -quiet] ne ""} {incr i} {
        catch { close_bd_design [current_bd_design -quiet] }
    }
    if {[current_bd_design -quiet] ne ""} {
        puts "[color $clr_error "ERROR: block design [current_bd_design -quiet] is still current; bd_dcmac would build in inline mode"]"
        exit 1
    }

    # dcmac_axil=1 and dcmac_mon=1: the DCMAC's PG369 register space and a
    # segment-level monitor are reachable from the host through
    # dcmac_axis_wrapper's register port (see dcmac_debug.sv). That is the only
    # way to see the hard block's own counters and PHY/MAC status.
    if {[bd_dcmac "" $dcmac_index 0 1 $cfg(fdev) $cfg(nclk_f) 1] != 0} {
        puts "[color $clr_error "ERROR: bd_dcmac failed for $cfg(fdev) index $dcmac_index"]"
        exit 1
    }
    # NOTE: build the name with `format`. Do NOT use Tcl brace substitution
    # (a dollar sign followed by the variable name in curly braces) anywhere in
    # this file: it goes through CMake configure_file() WITHOUT @ONLY, so CMake
    # reads that as one of its own variable references, finds nothing, and
    # substitutes the empty string. The symptom is a silently mangled name -
    # "dcmac__versal_axis_wrapper.bd" - and a "No files matched" warning at
    # project creation. That is also why the crossbar loop above uses a bare $i.
    set dcmac_bd [format "dcmac_%d_versal_axis_wrapper.bd" $dcmac_index]
    set_property SYNTH_CHECKPOINT_MODE "Hierarchical" [get_files $dcmac_bd]
    # Leave no design current, for the same reason as above.
    catch { close_bd_design [current_bd_design -quiet] }
}

if {$cfg(en_dcard) eq 1} {
    source "$hw_dir/bd/$cfg(fpga_arch)/cr_ddr.tcl" -notrace
    cr_bd_design_ddr ""
    set_property SYNTH_CHECKPOINT_MODE "Hierarchical" [get_files design_ddr.bd ]
}

if {$cfg(en_hcard) eq 1} {
    if {$cfg(hbm_split) eq 1} {
      source "$hw_dir/bd/$cfg(fpga_arch)/cr_hbm_split.tcl" -notrace 
    } else {
      source "$hw_dir/bd/$cfg(fpga_arch)/cr_hbm.tcl" -notrace 
    }

    # The HBM NoC controller accepts AXI inputs with DATA_WIDTH <= 256
    # Therefore, before the HBM controller, add a SmartConnect that does
    # clock domain crossing and data width conversion. On UltraScale+ devices,
    # a similar functionality exists, but as part of the HBM BD. However, on Versal,
    # since both the NoC and the SmartConnect IP need address assignment, 
    # it's best to keep them separate.
    if {$cfg(fpga_arch) eq "versal"} {
        cr_bd_hbm_cc_dwc ""
    }

    cr_bd_design_hbm ""
    set_property SYNTH_CHECKPOINT_MODE "Hierarchical" [get_files design_hbm.bd ]
}

########################################################################################################
# SHELL PROJECT CREATED
########################################################################################################
close_project
puts "[color $clr_flow "** Shell project created"]"
puts "[color $clr_flow "**"]"

########################################################################################################

} errorstring]} {
    puts "[color $clr_error "** CERR: $errorstring"]"
    puts "[color $clr_error "**"]"
    exit 1
}

exit 0