######################################################################################
# Lock an accepted config-0 shell and finalize the dynamic DFX artifact bundle.
######################################################################################
if {[catch {
    source "${CMAKE_BINARY_DIR}/base.tcl"
    file delete -force "$dcp_dir/dynamic_finalize_complete"
    if {$cfg(n_config) != 1 || $cfg(n_reg) != 1} {
        error "Immutable packaged dynamic flow currently requires one configuration and one region"
    }

    open_checkpoint "$dcp_dir/config_0/shell_routed_c0.dcp"
    for {set j 0} {$j < $cfg(n_reg)} {incr j} {
        update_design -black_box -cell \
            "inst_shell/inst_dynamic/inst_user_wrapper_$j"
    }
    lock_design -level routing
    write_checkpoint -force "$dcp_dir/shell_routed_locked.dcp"
    close_project

    if {$cfg(fpga_arch) eq "ultrascale_plus"} {
        open_checkpoint "$dcp_dir/config_0/shell_routed_c0.dcp"
        pr_recombine -cell inst_shell
        write_checkpoint -force "$dcp_dir/shell_recombined.dcp"
        close_project
    } else {
        file copy -force "$dcp_dir/config_0/shell_routed_c0.dcp" \
            "$dcp_dir/shell_routed.dcp"
    }

    set completion [open "$dcp_dir/dynamic_finalize_complete" w]
    puts $completion "dynamic finalize complete"
    close $completion
} errorstring]} {
    puts "[color $clr_error "** CERR: $errorstring"]"
    exit 1
}
exit 0
