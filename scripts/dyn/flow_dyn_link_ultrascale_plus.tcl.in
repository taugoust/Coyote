######################################################################################
# Immutable config-0 dynamic link for UltraScale+ nested DFX.
######################################################################################
if {[catch {
    source "${CMAKE_BINARY_DIR}/base.tcl"
    file delete -force "$dcp_dir/dynamic_link_complete"
    if {$cfg(n_config) != 1 || $cfg(n_reg) != 1} {
        error "Immutable packaged dynamic flow currently requires one configuration and one region"
    }

    open_checkpoint "$dcp_dir/shell_routed.dcp"
    set subcells {}
    for {set j 0} {$j < $cfg(n_reg)} {incr j} {
        lappend subcells "inst_shell/inst_dynamic/inst_user_wrapper_$j"
    }
    pr_subdivide -cell inst_shell -subcells $subcells \
        "$dcp_dir/shell/shell_synthed.dcp"
    write_checkpoint -force "$dcp_dir/shell_subdivided.dcp"
    close_project

    create_project -in_memory -part $part
    add_file "$dcp_dir/shell_subdivided.dcp"
    add_files -fileset [get_filesets constrs_1] "$hw_dir/constraints/$cfg(fdev)/shell/impl"
    add_files -fileset [get_filesets constrs_1] "$hw_dir/constraints/$cfg(fdev)/dynamic/impl"
    add_files -fileset [get_filesets constrs_1] "$hw_dir/constraints/$cfg(fdev)/fplan"
    if {$cfg(fplan_path) != "0"} {
        add_files -fileset [get_filesets constrs_1] "$cfg(fplan_path)"
        set_property PROCESSING_ORDER LATE [get_files [file tail $cfg(fplan_path)]]
    }
    for {set j 0} {$j < $cfg(n_reg)} {incr j} {
        set user_dcp "$dcp_dir/config_0/user_synthed_c0_$j.dcp"
        add_files $user_dcp
        set_property SCOPED_TO_CELLS \
            "inst_shell/inst_dynamic/inst_user_wrapper_$j" [get_files $user_dcp]
    }
    link_design -mode default -reconfig_partitions $subcells -part $part -top cyt_top
    write_checkpoint -force "$dcp_dir/config_0/shell_linked_c0.dcp"
    close_project

    set completion [open "$dcp_dir/dynamic_link_complete" w]
    puts $completion "dynamic link complete"
    close $completion
} errorstring]} {
    puts "[color $clr_error "** CERR: $errorstring"]"
    exit 1
}
exit 0
