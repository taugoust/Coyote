# @brief Runs Place & Route on a previously linked Coyote project

if {[catch {
    
########################################################################################################

# Config
source "${CMAKE_BINARY_DIR}/base.tcl"
file delete -force "$dcp_dir/shell_route_complete"

########################################################################################################
# PLACE & ROUTE
########################################################################################################

puts "[color $clr_flow "** Starting shell place and route ..."]"
puts "[color $clr_flow "**"]"

open_checkpoint "$dcp_dir/shell_linked.dcp"

set opt_directive "${IMPLEMENTATION_OPT_DIRECTIVE}"
if {$opt_directive eq "project"} {
    set opt_directive [expr {$cfg(build_opt) eq 1 ? "Explore" : ""}]
}
if {$opt_directive ne ""} {
    opt_design -directive $opt_directive
} else {
    opt_design
}
write_checkpoint -force "$dcp_dir/shell_opted.dcp"
puts "[color $clr_flow "** Shell opt_design completed"]"
puts "[color $clr_flow "**"]"

set place_directive "${IMPLEMENTATION_PLACE_DIRECTIVE}"
if {$place_directive eq "project"} {
    if {$cfg(build_opt) eq 1} {
        if {$cfg(fpga_arch) eq "versal" &&
            [package vcompare [version -short] "2024.2"] >= 0} {
            set place_directive AggressiveExplore
        } else {
            set place_directive Auto_1
        }
    } else {
        set place_directive ""
    }
}
if {$place_directive ne ""} {
    place_design -directive $place_directive
} else {
    place_design
}
write_checkpoint -force "$dcp_dir/shell_placed.dcp"
puts "[color $clr_flow "** Shell place_design completed"]"
puts "[color $clr_flow "**"]"

set phys_opt_directive "${IMPLEMENTATION_PHYS_OPT_DIRECTIVE}"
if {$phys_opt_directive eq "project"} {
    set phys_opt_directive [expr {$cfg(build_opt) eq 1 ? "AggressiveExplore" : ""}]
}
if {$phys_opt_directive ne ""} {
    phys_opt_design -directive $phys_opt_directive
} else {
    phys_opt_design
}
write_checkpoint -force "$dcp_dir/shell_phys_opted.dcp"
puts "[color $clr_flow "** Shell phys_opt_design completed"]"
puts "[color $clr_flow "**"]"

set route_directive "${IMPLEMENTATION_ROUTE_DIRECTIVE}"
if {$route_directive eq "project"} {
    set route_directive [expr {$cfg(build_opt) eq 1 ? "AggressiveExplore" : ""}]
}
if {$route_directive ne ""} {
    route_design -directive $route_directive
} else {
    route_design
}
puts "[color $clr_flow "** Shell route_design completed"]"
puts "[color $clr_flow "**"]"

finalize_post_route_optimization \
    "${IMPLEMENTATION_POST_ROUTE_PHYS_OPT_DIRECTIVE}" \
    "${IMPLEMENTATION_FINAL_ROUTE_DIRECTIVE}"
puts "[color $clr_flow "** Shell post route optimization and route finalization completed"]"
puts "[color $clr_flow "**"]"
report_and_validate_routed_design \
    "routed shell" "$rprt_dir" "" shell_bitstream_gate
write_checkpoint -force "$dcp_dir/shell_routed.dcp"

########################################################################################################
# LOCK & SUBDIVIDE DESIGN
########################################################################################################
if {$cfg(build_static) eq 1} {
    update_design -cell inst_shell -black_box
    lock_design -level routing
    write_checkpoint -force "$dcp_dir/static_routed_locked.dcp"
    puts "[color $clr_flow "** Locked static design"]"
    puts "[color $clr_flow "**"]"
} else {
    puts "[color $clr_flow "** Shell compiled"]"
    puts "[color $clr_flow "**"]"
}

########################################################################################################
# P & R COMPLETED
########################################################################################################
close_project

# Sanity check for vFPGA floorplan
if {$cfg(en_pr) eq 1 && $cfg(fplan_path) eq "0"} {
    puts ""
    puts "[color $clr_cmplt "**"]"
    puts "[color $clr_cmplt "** Shell compilation flow completed"]"
    puts "[color $clr_cmplt "**"]"
    puts "[color $clr_cmplt "** -- Partial reconfiguration enabled, external floorplan not provided! --"]" 
    puts "[color $clr_cmplt "** -- Floorplan your design now!                                        --"]"
    puts "[color $clr_cmplt "** -- This can be done by opening below checkpoint in Vivado:           --"]"
    puts "[color $clr_cmplt "** --        checkpoints/shell_subdivided.dcp                           --"]"
    puts "[color $clr_cmplt "** --                                                                   --"]"
    puts "[color $clr_cmplt "** -- Once floorplaning is done, update the same checkpoint             --"]"
    puts "[color $clr_cmplt "** --                                                                   --"]"
    puts "[color $clr_cmplt "**"]"
    puts ""

    exit 1
} else {
    puts ""
    puts "[color $clr_cmplt "**"]"
    puts "[color $clr_cmplt "** Shell compilation flow completed"]"
    puts "[color $clr_cmplt "**"]"
    puts "" 
}

set completion [open "$dcp_dir/shell_route_complete" w]
puts $completion "shell route complete"
close $completion

########################################################################################################

} errorstring]} {
    puts "[color $clr_error "** CERR: $errorstring"]"
    puts "[color $clr_error "**"]"
    exit 1
}

exit 0
