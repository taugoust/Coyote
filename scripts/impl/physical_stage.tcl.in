######################################################################################
# Immutable physical implementation phase runner.
######################################################################################

if {[catch {
    source "${CMAKE_BINARY_DIR}/base.tcl"

    set phase "${IMPLEMENTATION_PHASE}"
    set input_dcp "${IMPLEMENTATION_INPUT_DCP}"
    set output_dcp "${IMPLEMENTATION_OUTPUT_DCP}"
    set completion_path "${IMPLEMENTATION_COMPLETION_PATH}"
    set report_dir "${IMPLEMENTATION_REPORT_DIR}"
    set report_suffix "${IMPLEMENTATION_REPORT_SUFFIX}"
    set label "${IMPLEMENTATION_LABEL}"
    set drc_name "${IMPLEMENTATION_DRC_NAME}"
    set validation_summary "${IMPLEMENTATION_VALIDATION_SUMMARY}"
    set telemetry_path "${IMPLEMENTATION_TELEMETRY_PATH}"
    set incremental_mode "${IMPLEMENTATION_INCREMENTAL_MODE}"
    set incremental_reference_dcp "${IMPLEMENTATION_INCREMENTAL_REFERENCE_DCP}"

    if {$phase ni {opt place route validate}} {
        error "Unsupported immutable implementation phase: $phase"
    }
    if {$input_dcp eq "" || $output_dcp eq "" || $completion_path eq "" ||
        $report_dir eq "" || $telemetry_path eq ""} {
        error "Immutable implementation phase requires explicit input, output, completion, report, and telemetry paths"
    }

    file delete -force $completion_path
    file mkdir [file dirname $output_dcp]
    file mkdir [file dirname $completion_path]
    file mkdir $report_dir
    if {$incremental_mode ni {none reference}} {
        error "Unsupported immutable implementation mode: $incremental_mode"
    }
    if {$incremental_mode eq "reference" && $cfg(fpga_arch) ne "ultrascale_plus"} {
        error "Incremental implementation references are supported only for UltraScale+ targets"
    }
    if {$incremental_reference_dcp ne "" &&
        ($incremental_mode ne "reference" || $phase ne "opt")} {
        error "An incremental reference DCP may be loaded only by the opt phase"
    }
    if {$incremental_mode eq "reference" && $phase eq "opt" &&
        $incremental_reference_dcp eq ""} {
        error "Incremental opt requires an explicit reference DCP"
    }

    set_param general.maxThreads $cfg(cores)
    open_checkpoint $input_dcp

    # The U280 QSFP1 GT quad is in SLR2. Aurora's generic OOC constraints do
    # not keep the associated 402 MHz fabric with the board-selected quad,
    # which lets lane logic spill into SLR1 and creates multi-nanosecond routed
    # paths. Keep the complete backend in the western half of the adjacent SLR
    # while implementing the outer shell. A DFX application configuration can
    # reserve that same top-west region with EXCLUDE_PLACEMENT; in that context
    # the shell-level Aurora pblock would leave its CDC BRAMs with no legal site,
    # so let the configuration placer use the remaining shell-owned resources.
    if {$cfg(fdev) eq "u280" && $cfg(peer_backend) eq "aurora_qsfp1"} {
        set application_exclusion [get_pblocks -quiet \
            pblock_inst_user_wrapper_0]
        set application_exclusion_active [expr {
            [llength $application_exclusion] == 1 &&
            [get_property EXCLUDE_PLACEMENT $application_exclusion]
        }]
        if {$application_exclusion_active} {
            puts "INFO: Skipping the outer-shell Aurora pblock because a DFX application exclusion is active"
        } else {
            set aurora_backend [get_cells -quiet \
                inst_shell/inst_peer_backend_aurora_qsfp1]
            if {[llength $aurora_backend] != 1} {
                error "Expected exactly one U280 Aurora peer backend, found [llength $aurora_backend]: $aurora_backend"
            }
            if {[llength [get_pblocks -quiet pblock_aurora_qsfp1]] == 0} {
                create_pblock pblock_aurora_qsfp1
                resize_pblock [get_pblocks pblock_aurora_qsfp1] -add \
                    {CLOCKREGION_X0Y8:CLOCKREGION_X3Y11}
                set_property IS_SOFT FALSE [get_pblocks pblock_aurora_qsfp1]
            }
            add_cells_to_pblock [get_pblocks pblock_aurora_qsfp1] \
                $aurora_backend
        }
    }
    if {$incremental_reference_dcp ne ""} {
        read_checkpoint -incremental $incremental_reference_dcp
    }

    switch -- $phase {
        opt {
            set directive "${IMPLEMENTATION_OPT_DIRECTIVE}"
            if {$directive eq "project"} {
                set directive [expr {$cfg(build_opt) eq 1 ? "Explore" : ""}]
            }
            if {$directive ne ""} { opt_design -directive $directive } else { opt_design }
        }
        place {
            set place_directive "${IMPLEMENTATION_PLACE_DIRECTIVE}"
            if {$place_directive eq "project"} {
                if {$cfg(build_opt) eq 1} {
                    if {$cfg(fpga_arch) eq "versal" && \
                        [package vcompare [version -short] "2024.2"] >= 0} {
                        set place_directive AggressiveExplore
                    } else {
                        set place_directive Auto_1
                    }
                } else {
                    set place_directive ""
                }
            }
            if {$place_directive ne ""} { place_design -directive $place_directive } else { place_design }
            set phys_directive "${IMPLEMENTATION_PHYS_OPT_DIRECTIVE}"
            if {$phys_directive eq "project"} {
                set phys_directive [expr {$cfg(build_opt) eq 1 ? "AggressiveExplore" : ""}]
            }
            if {$phys_directive ne ""} { phys_opt_design -directive $phys_directive } else { phys_opt_design }
        }
        route {
            set route_directive "${IMPLEMENTATION_ROUTE_DIRECTIVE}"
            if {$route_directive eq "project"} {
                set route_directive [expr {$cfg(build_opt) eq 1 ? "AggressiveExplore" : ""}]
            }
            if {$route_directive ne ""} { route_design -directive $route_directive } else { route_design }
            set post_directive "${IMPLEMENTATION_POST_ROUTE_PHYS_OPT_DIRECTIVE}"
            if {$post_directive eq "project"} {
                set post_directive [expr {$cfg(build_opt) eq 1 ? "AggressiveExplore" : ""}]
            }
            if {$post_directive ne ""} {
                set final_directive "${IMPLEMENTATION_FINAL_ROUTE_DIRECTIVE}"
                if {$final_directive eq "project"} { set final_directive "" }
                set candidate_checkpoint "[file rootname $output_dcp].routed_candidate.dcp"
                optimize_and_retain_best_routed_candidate \
                    $post_directive $final_directive $candidate_checkpoint
            }
        }
        validate {
            if {$validation_summary eq ""} {
                error "validate requires an explicit validation summary path"
            }
            report_bitstream_drc \
                $drc_name [file join $report_dir [format "shell_drc_bitstream_checks%s.rpt" $report_suffix]]
            write_implementation_observations \
                $phase $report_dir $report_suffix $telemetry_path $drc_name
            set outcome accepted
            set reasons {}
            if {[catch {require_clean_bitstream_drc $drc_name} reason]} {
                set outcome rejected
                lappend reasons $reason
            }
            set enforce_timing "${IMPLEMENTATION_ENFORCE_TIMING}"
            if {$enforce_timing eq "project"} { set enforce_timing $cfg(en_timing_check) }
            if {$enforce_timing eq 1 && \
                [catch {require_timing_closure $label} reason]} {
                set outcome rejected
                lappend reasons $reason
            }
            set escaped_reasons {}
            foreach reason $reasons {
                set escaped [string map [list \
                    "\\" "\\\\" "\"" "\\\"" "\n" "\\n" "\r" "\\r" "\t" "\\t"] $reason]
                lappend escaped_reasons "\"$escaped\""
            }
            file mkdir [file dirname $validation_summary]
            set summary [open $validation_summary w]
            puts $summary "{"
            puts $summary "  \"schemaVersion\": 1,"
            puts $summary "  \"outcome\": \"$outcome\","
            puts $summary "  \"reasons\": \[[join $escaped_reasons {, }]\]"
            puts $summary "}"
            close $summary
        }
    }

    if {$incremental_mode eq "reference" && $phase in {place route}} {
        report_incremental_reuse \
            -file [file join $report_dir [format "shell_%s_incremental_reuse%s.rpt" $phase $report_suffix]]
    }
    if {$phase ne "validate"} {
        write_implementation_observations \
            $phase $report_dir $report_suffix $telemetry_path ""
        if {$phase eq "place" && $cfg(fpga_arch) eq "versal"} {
            write_placement_diagnosis_evidence $report_dir $report_suffix
        }
    }
    write_checkpoint -force $output_dcp
    close_project
    set completion [open $completion_path w]
    puts $completion "$phase complete"
    close $completion
} errorstring]} {
    puts "[color $clr_error "** CERR: $errorstring"]"
    puts "[color $clr_error "**"]"
    exit 1
}

exit 0
