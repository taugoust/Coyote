# Helper script for Versal bitgen.
#
# Two responsibilities:
#   1) Insert `boot_device { pcie }` into the `bitstream_master` section so the
#      generated PDI is bootable over PCIe partial reconfiguration.
#   2) (EN_AMC=1) Emit an AVED-style "combine" BIF that appends AMC firmware to
#      an already-generated base PDI as a delayed-handoff RPU subsystem image.
#
# Why a two-step combine (base PDI, then combine) rather than injecting amc.elf
# into the base BIF directly:
#
#   AMC runs on R5-0 and needs its TCM banks. TCM is granted when the PLM brings
#   the R5 up as part of subsystem 0x1c000000. If amc.elf is loaded *inline*
#   during the main boot, the R5 handoff happens before the base platform (RPU
#   power domain, subsystem tables) is fully up, so XPm_RequestDevice(TCM_0_A)
#   fails and boot aborts — first as PLM 0x347 (bare partition, no subsystem
#   binding), then as 0x33C/0x801 (bound but configured too early).
#
#   AVED avoids this by fully booting a base PDI, then handing off amc.elf as a
#   separate `delay_handoff` RPU-subsystem image (fpt/pdi_combine.bif):
#       image { { type=bootimage, file=<base>.pdi } }
#       image { id=0x1c000000, name=rpu_subsystem, delay_handoff
#               { core=r5-0, file=amc.elf } }
#   The delayed handoff runs only after the base boot completes, so the RPU/TCM
#   are ready. We reproduce that exactly.
#
# Usage:
#   python fix_bif.py <bif_path>
#       Insert boot_device { pcie } into <bif_path> (base BIF prep).
#
#   python fix_bif.py --combine <out_bif> <base_pdi> <amc_elf> [apu_elf]
#       Write an AVED-style combine BIF to <out_bif>. Paths are BIF-relative
#       (relative to bootgen's CWD, i.e. build_dir), matching the convention
#       used for the base PDI's own partition file references.
#       With <apu_elf> (EN_APU=1) a second delayed-handoff image is appended,
#       booting the A72 alongside the R5.

import os
import sys

# AVED fpt/pdi_combine.bif, reproduced. `id = 0x1c000000` binds amc.elf to the
# default subsystem that owns the R5 TCM; `delay_handoff` defers R5 start until
# the base PDI has fully booted.
COMBINE_BIF_TEMPLATE = """all:
{{
    image
    {{
        {{ type=bootimage, file={base_pdi} }}
    }}
    image
    {{
        id = 0x1c000000, name=rpu_subsystem, delay_handoff
        {{ core=r5-0, file={amc_elf} }}
    }}
}}
"""


# Second delayed-handoff image, for the APU. Same subsystem id as the RPU image:
# bootgen v2025.1 was verified to accept same-id, different-id and
# single-image-two-core forms, so this is a runtime choice, not a syntax one.
# Coyote's pmc_data.cdo defines exactly one subsystem (pm_add_subsystem
# 0x1c000000) with zero requirements; binding the R5 anywhere else is what
# produced PLM 0x347 then 0x33C/0x801. The APU needs no TCM, so the default
# subsystem is sufficient and is the only one the CDO knows about.
# Combine BIF with no R5 image at all (APU-only build).
BASE_ONLY_BIF_TEMPLATE = """all:
{{
    image
    {{
        {{ type=bootimage, file={base_pdi} }}
    }}
}}
"""

APU_IMAGE_TEMPLATE = """    image
    {{
        id = 0x1c000000, name=apu_subsystem, delay_handoff
        {{ core=a72-0, file={apu_elf} }}
    }}
"""


def insert_boot_device(path):
    """Insert `boot_device { pcie }` after the id line inside bitstream_master."""
    with open(path, 'r') as f:
        lines = f.readlines()

    out = []
    inserted = False
    found_master_section = False

    for line in lines:
        out.append(line)

        if 'bitstream_master:' in line:
            found_master_section = True

        if found_master_section and not inserted and 'id =' in line:
            out.append(' boot_device { pcie }\n')
            inserted = True

    with open(path, 'w') as f:
        f.writelines(out)


def write_combine_bif(out_path, base_pdi, amc_elf, apu_elf=None):
    """Write an AVED-style combine BIF: base PDI, optionally + an R5-0 image,
    optionally + an A72-0 image. Pass '-' for amc_elf to omit the R5 image (an
    APU-only build). The two are independent: which R5 firmware is present (AMC
    or the co-processor provider, or none) must not decide whether the APU boots.
    """
    if amc_elf and amc_elf != '-':
        text = COMBINE_BIF_TEMPLATE.format(base_pdi=base_pdi, amc_elf=amc_elf)
    else:
        text = BASE_ONLY_BIF_TEMPLATE.format(base_pdi=base_pdi)
    if apu_elf:
        # Splice the APU image in before the final closing brace.
        stripped = text.rstrip()
        if not stripped.endswith('}'):
            raise RuntimeError('unexpected combine BIF shape; cannot splice APU image')
        text = stripped[:-1] + APU_IMAGE_TEMPLATE.format(apu_elf=apu_elf) + '}\n'
    with open(out_path, 'w') as f:
        f.write(text)
    print('fix_bif.py: wrote combine BIF ' + out_path +
          ' (base=' + base_pdi + ', amc=' + amc_elf +
          (', apu=' + apu_elf if apu_elf else '') + ')')


if __name__ == '__main__':
    if len(sys.argv) in (5, 6) and sys.argv[1] == '--combine':
        out_bif, base_pdi, amc_elf = sys.argv[2], sys.argv[3], sys.argv[4]
        apu_elf = sys.argv[5] if len(sys.argv) == 6 else None
        # Best-effort existence checks (bootgen fails cryptically on a missing
        # file). base_pdi may not exist yet at check time.
        for label, path in (('R5', amc_elf), ('APU', apu_elf)):
            if path and path != '-' and not os.path.isabs(path):
                bif_dir = os.path.dirname(os.path.abspath(out_bif))
                check = os.path.join(os.path.dirname(bif_dir), path)
                if not os.path.isfile(check):
                    print('fix_bif.py: WARNING: ' + label + ' file not found at ' +
                          check + ' (bootgen will fail if path is wrong)')
        write_combine_bif(out_bif, base_pdi, amc_elf, apu_elf)
        sys.exit(0)

    if len(sys.argv) == 2:
        insert_boot_device(sys.argv[1])
        sys.exit(0)

    print('Usage: python fix_bif.py <bif_path>')
    print('       python fix_bif.py --combine <out_bif> <base_pdi> <r5_elf|-> [apu_elf]')
    sys.exit(1)
